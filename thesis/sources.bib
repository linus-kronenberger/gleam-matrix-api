and Silva, Francisco Airton
and Lagrota, Vin{\'i}cius},
title={Matrix protocol: a comprehensive systematic mapping study},
journal={Journal of Cloud Computing},
year={2026},
month={Feb},
day={18},
volume={15},
number={1},
pages={20},
abstract={The Matrix protocol is gaining significant traction in the domain of decentralized communication, offering robust features like end-to-end encryption, federated server architecture, and seamless interoperability. As more applications and platforms adopt this protocol, understanding its performance and security implications becomes increasingly crucial. Evaluating the Matrix protocol's adoption and its impact on communication systems is challenging due to its decentralized nature, diverse implementation scenarios, and varying security requirements. Existing studies provide fragmented insights, lacking a comprehensive overview of how the Matrix protocol performs in real-world settings, especially concerning security, scalability, and interoperability. This paper presents a systematic mapping study, which rigorously examines 156 papers, narrowing them down to 21 primary studies that directly engage with the Matrix protocol. The study categorizes the research based on the relationship with the Matrix protocol, the main area of focus, the contributions made, and the specific features of the Matrix protocol explored. By employing visualizations and detailed cross-analysis, the study reveals key trends, research gaps, and provides a foundational understanding of the protocol's strengths and limitations in decentralized communication. This study aims to guide future research efforts, advocating for more structured evaluation frameworks to enhance the understanding and deployment of the Matrix protocol in diverse communication environments.},
issn={2192-113X},
doi={10.1186/s13677-025-00829-7},
url={https://doi.org/10.1186/s13677-025-00829-7}
}

